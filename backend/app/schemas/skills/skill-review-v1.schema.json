{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codetalk.local/schemas/skills/skill-review-v1.schema.json",
  "$comment": "review_evidence_digest is the canonical digest of review_evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "skill_id",
    "content_digest",
    "review_evidence_digest",
    "review_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-review-v1"
    },
    "review_id": {
      "$ref": "#/$defs/opaqueId"
    },
    "skill_id": {
      "$ref": "#/$defs/semanticId"
    },
    "content_digest": {
      "$ref": "#/$defs/digest"
    },
    "review_evidence_digest": {
      "$ref": "#/$defs/digest"
    },
    "review_evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "semanticId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "summary",
        "locations",
        "reason",
        "impact",
        "recommendation",
        "disposition"
      ],
      "properties": {
        "finding_id": {
          "$ref": "#/$defs/semanticId"
        },
        "severity": {
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "field"],
            "properties": {
              "path": {
                "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/safePath"
              },
              "field": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reason": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "recommendation": { "type": "string", "minLength": 1 },
        "disposition": {
          "enum": [
            "open",
            "resolved",
            "acknowledged"
          ]
        },
        "acknowledgement": {
          "$ref": "#/$defs/acknowledgement"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "acknowledged"
              }
            }
          },
          "then": {
            "required": [
              "acknowledgement"
            ]
          }
        }
      ]
    },
    "acknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_ref",
        "rationale"
      ],
      "properties": {
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposedPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_id",
        "finding_ids",
        "summary",
        "target_path",
        "base_digest",
        "unified_diff"
      ],
      "properties": {
        "patch_id": {
          "$ref": "#/$defs/semanticId"
        },
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semanticId"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "target_path": {
          "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/safePath"
        },
        "base_digest": {
          "$ref": "#/$defs/digest"
        },
        "unified_diff": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "session_id",
        "review_kind",
        "reviewed_paths",
        "reviewed_file_digests",
        "reviewed_at",
        "provider",
        "requested_model",
        "effective_model",
        "response_model",
        "declared_context_window_tokens",
        "requested_max_output_tokens",
        "decision",
        "findings",
        "proposed_patches"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "$ref": "#/$defs/opaqueId"
        },
        "review_kind": {
          "enum": [
            "full",
            "incremental"
          ]
        },
        "reviewed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/safePath"
          }
        },
        "reviewed_file_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {
                "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/safePath"
              },
              "digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "effective_model": {
          "type": "string",
          "minLength": 1
        },
        "response_model": {
          "type": "string",
          "minLength": 1
        },
        "declared_context_window_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "requested_max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "decision": {
          "enum": [
            "approved",
            "changes_requested",
            "acknowledged"
          ]
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "proposed_patches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/proposedPatch"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "requested_model": {
                "pattern": "(^|/)deepseek-v4-flash$"
              }
            }
          },
          "then": {
            "properties": {
              "declared_context_window_tokens": {
                "const": 200000
              },
              "requested_max_output_tokens": {
                "maximum": 4096
              }
            }
          }
        }
      ]
    }
  }
}
