{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codetalk.local/schemas/skills/skill-ir-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "content_digest",
    "required_agent_capabilities",
    "inputs",
    "steps",
    "artifacts",
    "deliveries",
    "scripts",
    "core_rules",
    "judge",
    "topological_order",
    "source_file_digests"
  ],
  "properties": {
    "schema_version": {
      "const": "skill-ir-v1"
    },
    "skill_id": {
      "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/semanticId"
    },
    "content_digest": {
      "$ref": "#/$defs/digest"
    },
    "required_agent_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/agentCapabilityName"
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/input"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/step"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/artifact"
      }
    },
    "deliveries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/delivery"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/script"
      }
    },
    "core_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/rule"
      }
    },
    "judge": {
      "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/judge"
    },
    "selected_workflow_path": {
      "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/safePath"
    },
    "topological_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/semanticId"
      }
    },
    "source_file_digests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "digest"
        ],
        "properties": {
          "path": {
            "$ref": "https://codetalk.local/schemas/skills/codetalk-skill-v1.schema.json#/$defs/safePath"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
