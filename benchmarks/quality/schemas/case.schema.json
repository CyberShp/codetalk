{
  "$defs": {
    "CaseTestExecution": {
      "additionalProperties": false,
      "properties": {
        "commands": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Commands",
          "type": "array"
        },
        "policy": {
          "enum": [
            "disabled",
            "allowlisted"
          ],
          "title": "Policy",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "commands"
      ],
      "title": "CaseTestExecution",
      "type": "object"
    },
    "TruthFileDescriptor": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "TruthFileDescriptor",
      "type": "object"
    },
    "TruthPackagePaths": {
      "additionalProperties": false,
      "properties": {
        "coverage_universe": {
          "$ref": "#/$defs/TruthFileDescriptor"
        },
        "critical_chains": {
          "$ref": "#/$defs/TruthFileDescriptor"
        },
        "execution_oracles": {
          "$ref": "#/$defs/TruthFileDescriptor"
        },
        "gold_claims": {
          "$ref": "#/$defs/TruthFileDescriptor"
        }
      },
      "required": [
        "gold_claims",
        "coverage_universe",
        "critical_chains",
        "execution_oracles"
      ],
      "title": "TruthPackagePaths",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "truth_package_version": {
            "pattern": "^(?:[2-9]|[1-9][0-9]+)$"
          }
        },
        "required": [
          "truth_package_version"
        ]
      },
      "then": {
        "properties": {
          "analysis_target": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "analysis_target"
        ]
      }
    }
  ],
  "properties": {
    "analysis_target": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis Target"
    },
    "case_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "title": "Case Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "quality-benchmark-case-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "test_execution": {
      "$ref": "#/$defs/CaseTestExecution"
    },
    "tier": {
      "enum": [
        "S",
        "E",
        "H"
      ],
      "title": "Tier",
      "type": "string"
    },
    "truth_package": {
      "$ref": "#/$defs/TruthPackagePaths"
    },
    "truth_package_version": {
      "pattern": "^[1-9][0-9]*$",
      "title": "Truth Package Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "project_id",
    "truth_package_version",
    "tier",
    "truth_package",
    "test_execution"
  ],
  "title": "QualityBenchmarkCase",
  "type": "object"
}
